<?php
/**
 * Authentication & CORS Configuration
 *
 * Copy this file to auth.php and customize.
 *
 * Credentials are USERNAME + PASSWORD — see users.php(.example)
 * `password_hash`. A login establishes a PHP session; the session files live
 * under secure/tmp/sessions (machine-written, auto-created — never edit or
 * commit them). This file holds the session lifetime knobs, the
 * self-registration gate, and CORS.
 */

return [
    'authentication' => [
        // Session lifetime knobs (seconds).
        'session' => [
            'idle_ttl'     => 86400,     // inactivity before a session stops being
                                        // accepted (1 day). Sliding: it moves
                                        // forward as the caller works.
            'remember_ttl' => 2592000,   // how long a "remember me" session cookie
                                        // survives a browser restart (30 days).
                                        // Without it the cookie dies with the
                                        // browser session.
            'sweep_divisor' => 10,       // 1-in-N chance that a login also sweeps
                                        // the session store (0 = never). PHP's own
                                        // collector cannot do this job: it runs on
                                        // 0.1% of session starts and its lifetime
                                        // must cover remember_ttl, so it refuses to
                                        // touch anything younger than the longest
                                        // promise here. QuickSite sweeps on its own
                                        // idle rule instead. The operator CLI
                                        // (secure/cli/session-sweep.php) forces a
                                        // pass regardless of this setting.
        ],
        // Self-registration policy. allow_self_registration false (secure
        // default) = no register page, no public register command; accounts
        // exist from setup (users.php) only. When true, /admin/register and
        // POST /management/register create accounts, subject to the flood
        // controls below. min_password_length also applies to the account password change.
        // For every limit: 0 = no limit.
        'registration' => [
            'allow_self_registration' => false,
            'min_password_length'     => 12,   // register + account password change
            'max_users'               => 0,    // absolute account cap (users.php entries)
            'throttle' => [
                'per_ip_per_minute' => 3,      // register attempts per IP per minute
                'global_per_hour'   => 30,     // successful registrations per hour, install-wide
            ],
        ],
    ],
    // Cross-origin access to /management. Same-origin calls — the admin panel,
    // and any page served by this install — never consult this list: they are
    // recognised as same-origin and allowed before it is read. It governs OTHER
    // sites calling this API from a browser.
    //
    // SECURITY: 'allowed_origins' ships EMPTY on purpose. It used to ship ['*'],
    // which made every new install answer any origin that asked. Name the
    // origins you actually serve — 'https://app.example.com' — one per entry.
    // A '*' entry is still honoured if you add one, but it means exactly what it
    // says: every site on the internet may call this API from a visitor's
    // browser.
    'cors' => [
        'enabled' => true,
        'allowed_origins' => [],
        'allowed_methods' => ['POST', 'OPTIONS'],
        'allowed_headers' => ['Content-Type', 'Authorization', 'Accept-Language'],
        'max_age' => 3600,
    ],
];
