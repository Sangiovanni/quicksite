# =============================================================================
# QuickSite — Apache vhost example for the AUTHORING install.
#
# ONE VHOST IS ALL THIS FILE NEEDS. QuickSite serves every project at
# /p/<projectId>/ on the install's own hostname, for editing and for preview,
# for as long as the project exists. A finished site goes to production as a
# BUILD — a self-contained deliverable with its own web root and its own vhost,
# which is not this install and is not configured here.
#
#   ⚠ SetEnv QS_PROJECT IS WITHDRAWN AND DOES NOTHING.
#   A vhost used to be able to declare which project it served, making that
#   domain's root the site. That is gone: it put uncompiled pages on the public
#   internet (re-parsing on every request what a build compiles once) and it
#   broke the visual editor, because a domain serving one project had to refuse
#   the /p/<projectId>/ URLs the editor's preview iframe loads. If you have the
#   directive in a vhost, delete it — the engine no longer reads it.
#
# The variables below are read, and none of them selects a project:
#
#   SetEnv QS_PUBLIC_BASE_URL  <base>        the public base that absolute-by-
#                                            spec artifacts are generated
#                                            against — today that is sitemap.txt.
#                                            A sitemap has to name the URL the
#                                            BUILT site will be deployed at, and
#                                            this install cannot derive that from
#                                            the request in front of it, so the
#                                            deployer declares it. It also covers
#                                            sub-path mounts and reverse proxies,
#                                            where the request-derived origin
#                                            would be wrong. In-page links are
#                                            root-relative and never need it.
#   SetEnv QS_TRUSTED_HOSTS    a,b           optional Host-header pin (comma-
#                                            separated host[:port]); a request
#                                            with any other Host composes URLs
#                                            against the FIRST entry.
#   SetEnv QS_ERROR_PAGE_404   /404.html     optional: your own static pages for
#   SetEnv QS_ERROR_PAGE_403   /403.html     QuickSite's project-less/refused
#   SetEnv QS_ERROR_PAGE_400   /400.html     statuses. Root-relative, inside the
#                                            document root, .html/.htm only.
#                                            404 covers "no such project" AND
#                                            every refused project view (they are
#                                            deliberately indistinguishable);
#                                            403/400 cover malformed or forbidden
#                                            asset requests.
#                                            (A missing PAGE inside a project
#                                            that resolved renders that project's
#                                            own 404 template — no config needed.)
#
# Shared hosting (no vhost access): every SetEnv above is also legal in a
# .htaccess file at the document root.
#
# VERIFIED ON: Apache 2.4 (WAMP). Needs mod_env for SetEnv; the per-directory
# .htaccess files QuickSite ships need mod_rewrite.
#
# ---- UPLOADS: NOTHING TO DO HERE (unlike nginx) -----------------------------
# Apache's LimitRequestBody defaults to 0 = unlimited, so PHP's own
# post_max_size is the only ceiling and PHP answers an oversized upload itself,
# in JSON, naming the real limit. If you SET LimitRequestBody, keep it above
# post_max_size or Apache starts refusing first, with an HTML error page that
# explains nothing. (nginx is the opposite: its default of 1 MB is smaller than
# PHP's and has to be raised — see nginx-vhosts.conf.example.)
#
# Copy what you need into your Apache configuration and adjust paths/domains.
# This file is documentation — nothing in QuickSite reads or writes it.
#
# ---- THE SIX ENTRY POINTS ---------------------------------------------------
# QuickSite is six self-contained namespaces under the public folder, each with
# its own front controller and its own per-directory .htaccess:
#
#   /admin/api/    -> public/admin/api/index.php    panel AJAX helper
#   /admin/self/   -> public/admin/self/index.php   the account + memberships
#   /admin/state/  -> public/admin/state/index.php  the panel's per-user state
#   /management/   -> public/management/index.php   the command API
#   /admin/        -> public/admin/index.php        the admin panel
#   /p/            -> public/p/index.php            the project renderer
#
# Those six .htaccess files ship with QuickSite and need no configuration —
# they apply to every vhost pointed at the same DocumentRoot. Apache resolves
# each directory's own file automatically, which is why nothing central has to
# be kept in step here; nginx has no such mechanism and needs a location per
# namespace (see nginx-vhosts.conf.example). There is
# deliberately NO public/index.php and no FallbackResource at the root: the web
# root is FREE, so your own hand-made site can live there and QuickSite never
# squats the domain root.
# =============================================================================

# ---- the install's own hostname — the authoring surface ---------------------
<VirtualHost *:80>
    ServerName   quicksite.example.internal
    DocumentRoot /srv/quicksite/public

    # Optional. Declare it when this install generates sitemaps for a site whose
    # deployed URL differs from this hostname — which is the normal case, since
    # the deployed site is a build living somewhere else.
    # SetEnv QS_PUBLIC_BASE_URL "https://example.com/"
    # SetEnv QS_TRUSTED_HOSTS   "quicksite.example.internal"
    # SetEnv QS_ERROR_PAGE_404  "/404.html"
    # SetEnv QS_ERROR_PAGE_403  "/403.html"

    # Nothing else is needed. Every project is reachable at /p/<projectId>/
    # (visibility-gated), links compose against the request-derived
    # /p/<projectId>/ base, the visual editor works because its preview iframe
    # is exactly that URL, and the ROOT STAYS FREE for your own site.
    #
    # The shipped public/.htaccess already sets `Options -Indexes`, so a bare "/"
    # without an index file answers 403 rather than listing the install's folders.
</VirtualHost>

# ---- a DEPLOYED BUILD, for reference ----------------------------------------
# A build is not this install and does not share its configuration. It ships its
# own public/ and secure/ folders (renamed at build time — the renaming is part
# of the security model, since anyone scanning the deployed server cannot then
# guess paths from the open-source repo layout) and it serves exactly one site
# from its own root. Point DocumentRoot at the build's public folder; no QS_*
# variable selects anything, because there is only one project there.
#
# <VirtualHost *:443>
#     ServerName   example.com
#     DocumentRoot /srv/example.com/www
#     # SSL directives, logs, etc. as usual for your setup.
# </VirtualHost>
