# =============================================================================
# QuickSite — Apache vhost examples: one install, N projects, N domains.
#
# QuickSite has NO "served project" state. Which project a domain serves is a
# DEPLOYMENT decision, declared here and read per-request by the engine:
#
#   SetEnv QS_PROJECT          <projectId>   which project this domain serves
#   SetEnv QS_PUBLIC_BASE_URL  <base>        the public base the project's
#                                            sitemap (and other absolute-by-spec
#                                            artifacts) are generated against.
#                                            In-page links are root-relative and
#                                            do not need it; declare it anyway —
#                                            it also covers sub-path mounts and
#                                            reverse proxies where the request-
#                                            derived origin would be wrong.
#   SetEnv QS_TRUSTED_HOSTS    a,b           optional Host-header pin (comma-
#                                            separated host[:port]); a request
#                                            with any other Host composes URLs
#                                            against the FIRST entry.
#   SetEnv QS_ERROR_PAGE_404   /404.html     optional: your own static pages for
#   SetEnv QS_ERROR_PAGE_403   /403.html     QuickSite's project-less/refused
#   SetEnv QS_ERROR_PAGE_400   /400.html     statuses. Root-relative, inside the
#                                            document root, .html/.htm only.
#                                            404 covers "no such project" AND
#                                            every refused project view (they are
#                                            deliberately indistinguishable);
#                                            403/400 cover malformed or forbidden
#                                            asset requests.
#                                            (A missing PAGE inside a served
#                                            project renders that project's own
#                                            404 template — no config needed.)
#
# Shared hosting (no vhost access): every SetEnv above is also legal in a
# .htaccess file at the document root. So is FallbackResource. RewriteRule is
# too, but the pattern loses its leading slash there — `^p(/|$)` in .htaccess,
# `^/p(/|$)` in a vhost, which is why the mapped-domain examples below cannot be
# pasted into .htaccess unchanged.
#
# VERIFIED ON: Apache 2.4 (WAMP). Needs mod_rewrite for the RewriteRule and
# mod_env for SetEnv; FallbackResource is core.
#
# ---- UPLOADS: NOTHING TO DO HERE (unlike nginx) -----------------------------
# Apache's LimitRequestBody defaults to 0 = unlimited, so PHP's own
# post_max_size is the only ceiling and PHP answers an oversized upload itself,
# in JSON, naming the real limit. If you SET LimitRequestBody, keep it above
# post_max_size or Apache starts refusing first, with an HTML error page that
# explains nothing. (nginx is the opposite: its default of 1 MB is smaller than
# PHP's and has to be raised — see nginx-vhosts.conf.example.)
#
# Copy what you need into your Apache configuration and adjust paths/domains.
# This file is documentation — nothing in QuickSite reads or writes it.
#
# ---- THE FOUR ENTRY POINTS --------------------------------------------------
# QuickSite is four self-contained namespaces under the public folder, each with
# its own front controller and its own per-directory .htaccess:
#
#   /admin/api/   -> public/admin/api/index.php   panel AJAX helper
#   /management/  -> public/management/index.php  the command API
#   /admin/       -> public/admin/index.php       the admin panel
#   /p/           -> public/p/index.php           the project renderer
#
# Those four .htaccess files ship with QuickSite and need no configuration —
# they apply to every vhost pointed at the same DocumentRoot. There is
# deliberately NO public/index.php: the web root is free, so your own hand-made
# site can live there and QuickSite never squats the domain root. A mapped
# domain is the one case that DOES want the root funnelled into the engine,
# which is what the FallbackResource below adds — per vhost, never install-wide.
#
# ---- ⚠ NEVER SET QS_PROJECT ON THE HOSTNAME THAT SERVES /admin/ -------------
# A mapped domain serves ONE project at its root and answers 404 to any literal
# /p/… request — one domain, one site, and that is what stops a production
# domain being used to enumerate the other projects on the install. The visual
# editor's preview iframe is `/p/<projectId>/`. So a vhost that has QS_PROJECT
# set AND serves the admin panel gives you an editor whose preview 404s.
#
# The two roles are separate hostnames on purpose: mapped domains SERVE, the
# authoring hostname EDITS. Every project on the install — including the ones
# with their own domains — is edited at /p/<projectId>/ on the authoring
# hostname, which is where the panel already points. See the last vhost below.
# =============================================================================

# ---- example.com  ->  project "siteA" ---------------------------------------
<VirtualHost *:443>
    ServerName   example.com
    DocumentRoot /srv/quicksite/public

    SetEnv QS_PROJECT         "siteA"
    SetEnv QS_PUBLIC_BASE_URL "https://example.com/"
    SetEnv QS_TRUSTED_HOSTS   "example.com"
    # SetEnv QS_ERROR_PAGE_404 "/404.html"
    # SetEnv QS_ERROR_PAGE_403 "/403.html"

    RewriteEngine On
    # One domain, one site: a direct /p/... hit is not this domain's surface.
    # (The engine also enforces this itself when QS_PROJECT is set.)
    RewriteRule ^/p(/|$)  -  [R=404,L]

    # This domain's root IS the project. /admin/ /admin/api/ /management/ keep
    # their own per-directory FallbackResource and are unaffected by this one.
    FallbackResource /p/index.php

    # SSL directives, logs, etc. as usual for your setup.
</VirtualHost>

# ---- shop.example.net  ->  project "siteB" ----------------------------------
<VirtualHost *:443>
    ServerName   shop.example.net
    DocumentRoot /srv/quicksite/public

    SetEnv QS_PROJECT         "siteB"
    SetEnv QS_PUBLIC_BASE_URL "https://shop.example.net/"
    SetEnv QS_TRUSTED_HOSTS   "shop.example.net"

    RewriteEngine On
    RewriteRule ^/p(/|$)  -  [R=404,L]
    FallbackResource /p/index.php
</VirtualHost>

# ---- the install's own hostname — the AUTHORING surface ---------------------
<VirtualHost *:80>
    ServerName   quicksite.example.internal
    DocumentRoot /srv/quicksite/public
    # No QS_PROJECT, no QS_PUBLIC_BASE_URL:
    #   - every project is reachable at /p/<projectId>/ (visibility-gated),
    #   - links compose against the request-derived /p/<projectId>/ base,
    #   - the ROOT STAYS FREE for your own hand-made site (no FallbackResource),
    #   - and THE VISUAL EDITOR WORKS. Its preview iframe is /p/<projectId>/,
    #     which a QS_PROJECT vhost answers 404 by design (see the top of this
    #     file). The missing SetEnv here is load-bearing, not an omission.
    # The shipped public/.htaccess already sets `Options -Indexes`, so a bare "/"
    # without an index file answers 403 rather than listing the install's folders.
</VirtualHost>
