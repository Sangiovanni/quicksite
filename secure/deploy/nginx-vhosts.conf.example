# =============================================================================
# QuickSite — nginx server-block examples: one install, N projects, N domains.
#
# Same model as the Apache twin (apache-vhosts.conf.example, which also
# documents every QS_* variable): the DEPLOYMENT declares which project a
# domain serves via fastcgi_param; QuickSite holds no serving state.
#
# NOTE: this is separate from secure/nginx/dynamic_routes.conf (the generated
# routing include for the AUTHORING install). Copy what you need into your
# site config and adjust paths/domains/php upstream. Nothing reads this file.
#
# VERIFIED ON: nginx as configured by CloudPanel. Another nginx install differs
# mainly in three places — the php-fpm upstream name (`fastcgi_pass php;`
# below), where `fastcgi_params` lives, and whether your panel owns the server
# block and will overwrite hand edits. Everything else here is plain nginx.
#
# nginx does not list directories unless `autoindex on` is set — the free root
# needs no extra directive here.
#
# ---- ⚠ REQUIRED ON EVERY BLOCK THAT RECEIVES AN UPLOAD ----------------------
# nginx allows a request body of 1 MB by default. That is SMALLER than the
# upload size a normal PHP configuration accepts, so an nginx install refuses
# uploads QuickSite advertises as fine — and refuses them in the way that hides
# the reason: nginx answers 413 with its own HTML error page BEFORE PHP runs, so
# no QuickSite code executes and nothing in the answer is JSON. Apache's
# LimitRequestBody is unlimited by default, which is why an Apache install
# cannot reproduce this.
#
#     client_max_body_size 51m;   # ← match YOUR php.ini, see below
#
# THE NUMBER IS NOT A CONSTANT. Set it one megabyte or so ABOVE this server's
# `post_max_size`, so PHP is always the component that refuses an oversized
# upload — PHP's refusal is JSON naming the real limit, nginx's is an HTML page
# naming nothing. QuickSite already computes the right value for your server:
# it is in the generated `secure/nginx/dynamic_routes.conf`, on the
# `/management/` block, and the nginx setup page prints it. Uploads reach
# QuickSite only through `/management/`, so that one block is the whole story
# for a single-server-block vhost — the value below is for the mapped-domain
# blocks in this file, which serve the same install.
#
# ⚠ A PROXYING PUBLIC BLOCK NEEDS ITS OWN COPY. In the two-block layout
# described further down, the public block terminates the client connection, so
# its own 1 MB default rejects the body before the backend is ever dialled.
#
# ---- ⚠ NEVER SET QS_PROJECT ON THE HOSTNAME THAT SERVES /admin/ -------------
# A mapped domain serves ONE project at its root and answers 404 to any literal
# /p/… request — one domain, one site, and that is what stops a production
# domain being used to enumerate the other projects on the install. The visual
# editor's preview iframe is `/p/<projectId>/`. So a vhost that has QS_PROJECT
# set AND serves the admin panel gives you an editor whose preview 404s.
#
# The two roles are separate hostnames on purpose: mapped domains SERVE, the
# authoring hostname EDITS. Every project on the install — including the ones
# with their own domains — is edited at /p/<projectId>/ on the authoring
# hostname, which is where the panel already points. See the last block in this
# file.
#
# ---- THE FOUR ENTRY POINTS --------------------------------------------------
# QuickSite is four self-contained namespaces under the public folder, each with
# its own front controller. Every routing rule below exists to put a request in
# front of the RIGHT one:
#
#   /admin/api/   -> public/admin/api/index.php   panel AJAX helper
#   /management/  -> public/management/index.php  the command API
#   /admin/       -> public/admin/index.php       the admin panel
#   /p/           -> public/p/index.php           the project renderer
#
# `/admin/api/` needs its OWN location. nginx picks the LONGEST matching prefix,
# so without it `location /admin/` wins for /admin/api/… and hands those
# requests to the panel's front controller instead of the API's.
#
# There is deliberately NO public/index.php: the web root is free, so your own
# hand-made site can live there and QuickSite never squats the domain root.
#
# ---- ⚠ IF YOUR VHOST HAS A STATIC-ASSET REGEX -------------------------------
# Panel-generated vhosts usually carry something like
#
#     location ~* ^.+\.(css|js|png|…)$ { expires max; }
#
# and in nginx a REGEX location outranks a PREFIX one. A mapped domain serves its
# project's stylesheets, scripts and images THROUGH PHP — they live in
# secure/projects/<id>/public/, not in the web root, so the visibility gate can
# run before any byte is sent. A block like the one above will look for them on
# disk, not find them, and answer 404, while extensionless page routes keep
# rendering perfectly. If you have one, make it fall through instead:
#
#     location ~* ^.+\.(css|js|png|…)$ { try_files $uri @site; }
#
# The authoring surface at the bottom of this file solves the same problem a
# different way, with `^~` — see the note there.
#
# ---- ⚠ AND IF YOUR PANEL GENERATES TWO SERVER BLOCKS ------------------------
# CloudPanel (and panels like it) emit a PUBLIC block on 443 that proxies to a
# BACKEND block on 8080, and they put the static-asset regex in the PUBLIC one
# while the QuickSite include lands in the BACKEND one. A project stylesheet is
# then answered from disk by the public block and never proxied — pages render,
# every asset 404s — and `^~` in the included file cannot help, because the
# request never reaches the block that file is in.
#
# The public block needs its own passthrough, copying the proxy target from its
# own `location / { }`:
#
#     client_max_body_size 51m;   # this block receives the bytes — see the top
#     location ^~ /p/ {
#         COPY_THE_proxy_pass_LINE_FROM_YOUR_location_slash_BLOCK;
#         proxy_set_header Host $host;
#     }
#
# Copy that line rather than inventing a target — on CloudPanel it is a
# {{varnish_proxy_pass}} placeholder the panel fills in. It opens nothing:
# proxy_pass dials OUT, it does not listen, and the backend block is already
# listening either way. A 127.0.0.1 target is loopback — the machine talking to
# itself, never the network.
#
# Verified on nginx 1.24.0 by reproducing the two-block layout: without this the
# stylesheet is 404, with it the request reaches the project handler, and
# /p/index.php still answers 404 end to end.
#
# ---- WHY ONLY /p/ USES `^~` -------------------------------------------------
# `^~` means "if this prefix wins, do not consider regex locations at all". That
# is what /p/ needs, and it is also why the other three must NOT have it: their
# try_files fallback is a .php path, which re-enters location matching — with
# regex suppressed it would land back in the same block, find the front
# controller ON DISK, and serve it as plain text. `^~` plus a .php fallback
# hands out your source. The three plain prefixes below are correct as written.
# =============================================================================

# ---- example.com  ->  project "siteA" ---------------------------------------
server {
    listen      443 ssl;
    server_name example.com;
    root        /srv/quicksite/public;

    # REQUIRED for uploads — see the note at the top. 51m suits a server whose
    # post_max_size is 50M; use the value from your own generated
    # dynamic_routes.conf, not this one.
    client_max_body_size 51m;

    # The engine's own namespaces keep working on every domain. Longest prefix
    # first for readability — nginx picks by length, not by order.
    location /admin/api/  { try_files $uri $uri/ /admin/api/index.php$is_args$args; }
    location /management/ { try_files $uri $uri/ /management/index.php$is_args$args; }
    location /admin/      { try_files $uri $uri/ /admin/index.php$is_args$args; }

    # One domain, one site: /p/ is not this domain's surface.
    # (The engine also enforces this itself when QS_PROJECT is set.)
    location ^~ /p/ { return 404; }

    # Real files first (your own root files; project assets resolve inside the
    # engine), everything else renders the mapped project.
    #
    # No `$uri/` here on purpose: a directory should not produce an index
    # listing or a directory redirect on a mapped domain — every non-file URL
    # belongs to the project renderer.
    location / { try_files $uri @site; }

    location @site {
        include        fastcgi_params;
        fastcgi_param  QS_PROJECT          "siteA";
        fastcgi_param  QS_PUBLIC_BASE_URL  "https://example.com/";
        fastcgi_param  QS_TRUSTED_HOSTS    "example.com";
        # fastcgi_param QS_ERROR_PAGE_404  "/404.html";
        # fastcgi_param QS_ERROR_PAGE_403  "/403.html";
        fastcgi_param  SCRIPT_FILENAME     $document_root/p/index.php;
        fastcgi_pass   php;   # your php-fpm upstream
    }

    location ~ \.php$ {
        # try_files FIRST. Without it, /whatever.jpg/x.php is handed to PHP with
        # SCRIPT_FILENAME pointing at a path that does not exist, and a PHP built
        # with cgi.fix_pathinfo=1 walks back up and executes whatever.jpg. The
        # =404 is what makes this location refuse anything that is not a real
        # file on disk.
        try_files      $uri =404;
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass   php;
    }
}

# ---- shop.example.net  ->  project "siteB" ----------------------------------
server {
    listen      443 ssl;
    server_name shop.example.net;
    root        /srv/quicksite/public;

    client_max_body_size 51m;   # REQUIRED — see the note at the top

    location /admin/api/  { try_files $uri $uri/ /admin/api/index.php$is_args$args; }
    location /management/ { try_files $uri $uri/ /management/index.php$is_args$args; }
    location /admin/      { try_files $uri $uri/ /admin/index.php$is_args$args; }
    location ^~ /p/          { return 404; }
    location /               { try_files $uri @site; }

    location @site {
        include        fastcgi_params;
        fastcgi_param  QS_PROJECT          "siteB";
        fastcgi_param  QS_PUBLIC_BASE_URL  "https://shop.example.net/";
        fastcgi_param  QS_TRUSTED_HOSTS    "shop.example.net";
        fastcgi_param  SCRIPT_FILENAME     $document_root/p/index.php;
        fastcgi_pass   php;
    }

    location ~ \.php$ {
        try_files      $uri =404;
        include        fastcgi_params;
        fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass   php;
    }
}

# ---- the install's own hostname — the AUTHORING surface ---------------------
# No QS_PROJECT / QS_PUBLIC_BASE_URL: every project serves at /p/<projectId>/
# (visibility-gated) and the root stays free.
#
# ⚠ THE ABSENCE OF QS_PROJECT HERE IS LOAD-BEARING, NOT AN OMISSION. This is the
# hostname you sign in to and edit on, and the visual editor previews a project
# by loading /p/<projectId>/ in an iframe. Setting QS_PROJECT on this vhost
# turns those URLs into 404s (one domain, one site) and the editor stops working
# — for every project, not just the mapped one. Keep serving and authoring on
# separate hostnames; that is what the two blocks above and this one are.
#
# Do NOT hand-write the routing here. QuickSite generates it on the first page
# load, from the folder names and URL space you chose in setup, and rewrites it
# whenever those change — include the generated file instead. The page you get
# on that first load names the exact path and prints the block below with your
# install's paths already filled in.
#
# TWO things go in the server block, and BOTH are required:
#
#   1. the include, and
#   2. the `@quicksite_project` named location.
#
# The generated file routes /p/ with `^~`, which takes it out of competition with
# any static-asset regex your panel added — that is what makes stylesheets,
# scripts and images work here. But `^~` also suppresses the `.php` handler for
# anything it wins, so the fallback CANNOT be a path: it would re-enter matching,
# land back in the same block, find public/p/index.php on disk and serve the
# engine as plain text. A NAMED location is jumped to directly, with no second
# pass, which is why it is shaped this way.
#
# QuickSite cannot generate step 2 itself — only your server knows its PHP
# upstream. Without it, project URLs answer 500 and the error log says
# `could not find named location "@quicksite_project"`.
#
# server {
#     listen      80;
#     server_name quicksite.example.internal;
#     root        /srv/quicksite/public;
#
#     include     /srv/quicksite/secure/nginx/dynamic_routes.conf;
#
#     location @quicksite_project {
#         include        fastcgi_params;
#         # HARDCODED, deliberately. Deriving this from $fastcgi_script_name is
#         # what lets /photo.jpg/x.php execute an uploaded file; a fixed path has
#         # no request-controlled component, so that class cannot arise.
#         # With a URL space, this becomes $document_root/<space>/p/index.php —
#         # the generated file prints the exact line for your install.
#         fastcgi_param  SCRIPT_FILENAME $document_root/p/index.php;
#         fastcgi_pass   php;
#     }
#
#     location ~ \.php$ {
#         try_files      $uri =404;
#         include        fastcgi_params;
#         fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
#         fastcgi_pass   php;
#     }
# }
