{
    "$schema": "../schema.json",
    "id": "start-from-template",
    "version": "1.0.0",
    "meta": {
        "icon": "🧩",
        "titleKey": "workflows.specs.startFromTemplate.title",
        "descriptionKey": "workflows.specs.startFromTemplate.description",
        "category": "start",
        "tags": ["template", "starter", "landing", "business", "website", "multilingual", "dark"]
    },
    "stepsFrom": "template",
    "preWorkflows": [
        { "id": "fresh-start", "params": { "keepLanguages": true } },
        {
            "id": "setup-languages",
            "params": {
                "multilingual": "{{param.multilingual}}",
                "languages": "{{param.languages}}",
                "defaultLanguage": "{{param.language}}",
                "updateLangSwitch": "{{param.multilingual}}"
            }
        },
        { "id": "setup-theme-switch", "condition": "param.darkMode === true" }
    ],
    "parameters": [
        {
            "id": "template",
            "type": "template",
            "labelKey": "workflows.specs.startFromTemplate.params.template.label",
            "required": true
        },
        {
            "id": "multilingual",
            "type": "checkbox",
            "labelKey": "workflows.specs.startFromTemplate.params.multilingual.label",
            "helpKey": "workflows.specs.startFromTemplate.params.multilingual.help",
            "default": false,
            "condition": "chosen.template && chosen.template.languages.length > 1"
        },
        {
            "id": "languages",
            "type": "tag-select",
            "labelKey": "workflows.specs.startFromTemplate.params.languages.label",
            "helpKey": "workflows.specs.startFromTemplate.params.languages.help",
            "optionsFrom": { "data": "allLanguages", "value": "code", "label": "name", "filterFrom": "template" },
            "condition": "chosen.template && multilingual === true",
            "validation": { "minItems": 2 }
        },
        {
            "id": "language",
            "type": "select",
            "labelKey": "workflows.specs.startFromTemplate.params.language.label",
            "helpKey": "workflows.specs.startFromTemplate.params.language.help",
            "optionsFrom": { "data": "allLanguages", "value": "code", "label": "name", "filterFrom": ["template", "languages"] },
            "condition": "chosen.template"
        },
        {
            "id": "darkMode",
            "type": "checkbox",
            "labelKey": "workflows.specs.startFromTemplate.params.darkMode.label",
            "helpKey": "workflows.specs.startFromTemplate.params.darkMode.help",
            "default": false,
            "condition": "chosen.template && chosen.template.dark === true"
        }
    ],
    "dataRequirements": [
        {
            "id": "allLanguages",
            "command": "getLanguageList",
            "extract": "data.languages"
        }
    ],
    "steps": []
}
