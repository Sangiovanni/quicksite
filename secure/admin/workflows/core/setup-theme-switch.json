{
    "$schema": "../schema.json",
    "id": "setup-theme-switch",
    "version": "1.0.0",
    "meta": {
        "icon": "🌙",
        "titleKey": "workflows.specs.setupThemeSwitch.title",
        "descriptionKey": "workflows.specs.setupThemeSwitch.description",
        "category": "look",
        "tags": ["theme", "dark", "light", "switch", "toggle"]
    },
    "parameters": [],
    "dataRequirements": [
        {
            "id": "langData",
            "command": "getLangList",
            "extract": "data"
        }
    ],
    "steps": [
        {
            "comment": "=== THE SWITCH'S WORDS: its name and its first label, in each of the site's languages, QuickSite's starting words in that language (a language with no word file of its own takes English) ===",
            "forEach": "langData.languages",
            "command": "setTranslationKeys",
            "params": {
                "language": "{{$value}}",
                "translations": {
                    "themeSwitch": {
                        "toggle": "{{startingWord:visitor.aria.themeSwitch}}",
                        "dark": "{{startingWord:visitor.themeSwitch.dark}}"
                    }
                }
            }
        },
        {
            "comment": "=== THE SWITCH: its label names the mode a press switches to; after a press the site's runtime sets it in the page's language ===",
            "command": "editStructure",
            "params": {
                "type": "component",
                "name": "theme-switch",
                "structure": {
                    "tag": "button",
                    "params": {
                        "class": "theme-switch",
                        "data-theme-toggle": "true",
                        "type": "button",
                        "aria-label": "themeSwitch.toggle",
                        "aria-pressed": "false"
                    },
                    "children": [
                        {
                            "tag": "span",
                            "params": { "class": "theme-switch-icon", "aria-hidden": "true" },
                            "children": [{ "textKey": "__RAW__🌙" }]
                        },
                        {
                            "tag": "span",
                            "params": { "class": "theme-switch-label" },
                            "children": [{ "textKey": "themeSwitch.dark" }]
                        }
                    ]
                }
            }
        }
    ]
}
