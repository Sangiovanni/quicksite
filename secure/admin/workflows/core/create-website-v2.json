{
    "$schema": "../schema.json",
    "id": "create-website-v2",
    "version": "1.0.0",
    "meta": {
        "icon": "🌐",
        "titleKey": "ai.specs.createWebsiteV2.title",
        "descriptionKey": "ai.specs.createWebsiteV2.description",
        "category": "creation",
        "tags": ["create", "website", "multi-page", "single-page", "landing", "from-scratch", "phased"],
        "difficulty": "advanced"
    },
    "parameters": [
        {
            "id": "multilingual",
            "type": "checkbox",
            "labelKey": "workflows.specs.setupLanguages.params.multilingual.label",
            "helpKey": "workflows.specs.setupLanguages.params.multilingual.help",
            "default": false
        },
        {
            "id": "languages",
            "type": "tag-select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.languages.label",
            "helpKey": "workflows.specs.setupLanguages.params.languages.help",
            "placeholderKey": "workflows.specs.setupLanguages.params.languages.placeholder",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name"
            },
            "default": "{{data.langData.languages}}",
            "condition": "multilingual === true"
        },
        {
            "id": "defaultLanguage",
            "type": "select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.defaultLanguage.label",
            "helpKey": "workflows.specs.setupLanguages.params.defaultLanguage.help",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name",
                "filterFrom": "languages"
            },
            "default": "{{data.langData.default_language}}"
        },
        {
            "id": "onePage",
            "type": "checkbox",
            "labelKey": "ai.specs.createWebsite.params.onePage.label",
            "helpKey": "ai.specs.createWebsite.params.onePage.help",
            "default": false
        },
        {
            "id": "includeAssets",
            "type": "checkbox",
            "labelKey": "ai.specs.shared.params.includeAssets.label",
            "helpKey": "ai.specs.shared.params.includeAssets.help",
            "default": false
        },
        {
            "id": "includeFavicon",
            "type": "checkbox",
            "labelKey": "ai.specs.shared.params.includeFavicon.label",
            "helpKey": "ai.specs.shared.params.includeFavicon.help",
            "default": false,
            "condition": "includeAssets === true"
        },
        {
            "id": "keepAssets",
            "type": "checkbox",
            "labelKey": "ai.specs.shared.params.keepAssets.label",
            "helpKey": "ai.specs.shared.params.keepAssets.help",
            "default": true
        }
    ],
    "dataRequirements": [
        {
            "id": "allLanguages",
            "command": "getLanguageList",
            "extract": "data.languages"
        },
        {
            "id": "langData",
            "command": "getLangList",
            "extract": "data"
        },
        {
            "id": "helpAddRoute",
            "command": "help",
            "urlParams": ["addRoute"],
            "extract": "data"
        },
        {
            "id": "helpEditStructure",
            "command": "help",
            "urlParams": ["editStructure"],
            "extract": "data"
        },
        {
            "id": "helpSetTranslationKeys",
            "command": "help",
            "urlParams": ["setTranslationKeys"],
            "extract": "data"
        },
        {
            "id": "helpEditStyles",
            "command": "help",
            "urlParams": ["editStyles"],
            "extract": "data"
        },
        {
            "id": "assetList",
            "command": "listAssets",
            "urlParams": ["starred"],
            "extract": "data",
            "condition": "includeAssets === true"
        },
        {
            "id": "helpEditFavicon",
            "command": "help",
            "urlParams": ["editFavicon"],
            "extract": "data",
            "condition": "includeAssets === true && includeFavicon === true"
        }
    ],
    "relatedCommands": ["addRoute", "editStructure", "setTranslationKeys", "editStyles", "editFavicon"],
    "preWorkflows": [
        {
            "id": "fresh-start",
            "params": {
                "keepAssets": "{{param.keepAssets}}",
                "keepLanguages": false
            }
        },
        {
            "id": "setup-languages",
            "params": {
                "multilingual": "{{param.multilingual}}",
                "languages": "{{param.languages}}",
                "defaultLanguage": "{{param.defaultLanguage}}"
            }
        },
        {
            "id": "update-lang-switch",
            "condition": "param.multilingual === true"
        }
    ],
    "postWorkflows": [
        {
            "id": "translate-site",
            "condition": "param.multilingual === true",
            "forEach": "param.languages",
            "filter": "{{$value}} !== {{param.defaultLanguage}}",
            "label": "{{$value | langname}}",
            "params": {
                "language": "{{$value}}",
                "from": "{{param.defaultLanguage}}"
            },
            "request": "parent"
        },
        {
            "id": "restyle",
            "request": "parent"
        }
    ],
    "promptTemplate": "create-website-v2.md"
}
