{
    "$schema": "../schema.json",
    "id": "setup-languages",
    "version": "1.0.0",
    "meta": {
        "icon": "🌐",
        "titleKey": "workflows.specs.setupLanguages.title",
        "descriptionKey": "workflows.specs.setupLanguages.description",
        "category": "texts",
        "tags": ["language", "multilingual", "i18n", "setup"]
    },
    "parameters": [
        {
            "id": "multilingual",
            "type": "checkbox",
            "labelKey": "workflows.specs.setupLanguages.params.multilingual.label",
            "helpKey": "workflows.specs.setupLanguages.params.multilingual.help",
            "default": "{{data.langData.multilingual_enabled}}"
        },
        {
            "id": "languages",
            "type": "tag-select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.languages.label",
            "helpKey": "workflows.specs.setupLanguages.params.languages.help",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name"
            },
            "default": "{{data.langData.languages}}",
            "condition": "multilingual === true",
            "validation": {
                "minItems": 2
            }
        },
        {
            "id": "defaultLanguage",
            "type": "select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.defaultLanguage.label",
            "helpKey": "workflows.specs.setupLanguages.params.defaultLanguage.help",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name",
                "filterFrom": "languages"
            },
            "default": "{{data.langData.default_language}}"
        },
        {
            "id": "updateLangSwitch",
            "type": "checkbox",
            "labelKey": "workflows.specs.setupLanguages.params.updateLangSwitch.label",
            "helpKey": "workflows.specs.setupLanguages.params.updateLangSwitch.help",
            "default": true
        }
    ],
    "dataRequirements": [
        {
            "id": "allLanguages",
            "command": "getLanguageList",
            "extract": "data.languages"
        },
        {
            "id": "langData",
            "command": "getLangList",
            "extract": "data"
        }
    ],
    "relatedCommands": ["addLang", "deleteLang", "setDefaultLang"],
    "steps": [
        {
            "comment": "=== MULTI-LANG 1. Add only the languages the user picked that aren't already present. The box Several languages is the form's choice between one language and several, with nothing stored behind it: a site with two or more languages is multilingual, and adding the second carries default.json's words into the default language's file (addLang) ===",
            "condition": "param.multilingual === true",
            "forEach": "param.languages",
            "filter": "{{$value}} not_in {{data.langData.languages}}",
            "command": "addLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 2. Add the chosen base language (only when it is not present) ===",
            "condition": "param.multilingual !== true",
            "forEach": "param.defaultLanguage",
            "filter": "{{$value}} not_in {{data.langData.languages}}",
            "command": "addLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SHARED 3. Set default language (only when different from current), before any language is removed: the default cannot be ===",
            "condition": "param.defaultLanguage !== {{langData.default_language}}",
            "command": "setDefaultLang",
            "params": {
                "lang": "{{param.defaultLanguage}}"
            }
        },
        {
            "comment": "=== MULTI-LANG 4. Remove only the languages currently present that the user un-picked ===",
            "condition": "param.multilingual === true",
            "forEach": "data.langData.languages",
            "filter": "{{$value}} not_in {{param.languages}}",
            "command": "deleteLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 5. Delete every existing language except the chosen default: the last removal leaves one language, and deleteLang carries the default language's words into default.json ===",
            "condition": "param.multilingual !== true",
            "forEach": "data.langData.languages",
            "filter": "{{$value}} !== {{param.defaultLanguage}}",
            "command": "deleteLang",
            "params": {
                "code": "{{$value}}"
            }
        }
    ],
    "postWorkflows": [
        {
            "id": "update-lang-switch",
            "condition": "param.updateLangSwitch === true"
        }
    ]
}
