{
    "$schema": "../schema.json",
    "id": "setup-languages",
    "version": "1.0.0",
    "meta": {
        "icon": "🌐",
        "titleKey": "workflows.specs.setupLanguages.title",
        "descriptionKey": "workflows.specs.setupLanguages.description",
        "category": "modification",
        "tags": ["language", "multilingual", "i18n", "setup"],
        "difficulty": "beginner"
    },
    "parameters": [
        {
            "id": "multilingual",
            "type": "checkbox",
            "labelKey": "workflows.specs.setupLanguages.params.multilingual.label",
            "helpKey": "workflows.specs.setupLanguages.params.multilingual.help",
            "default": "{{data.langData.multilingual_enabled}}"
        },
        {
            "id": "languages",
            "type": "tag-select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.languages.label",
            "helpKey": "workflows.specs.setupLanguages.params.languages.help",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name"
            },
            "default": "{{data.langData.languages}}",
            "condition": "multilingual === true",
            "validation": {
                "minItems": 2
            }
        },
        {
            "id": "defaultLanguage",
            "type": "select",
            "searchable": true,
            "labelKey": "workflows.specs.setupLanguages.params.defaultLanguage.label",
            "helpKey": "workflows.specs.setupLanguages.params.defaultLanguage.help",
            "optionsFrom": {
                "data": "allLanguages",
                "value": "code",
                "label": "name",
                "filterFrom": "languages"
            },
            "default": "{{data.langData.default_language}}"
        },
        {
            "id": "updateLangSwitch",
            "type": "checkbox",
            "labelKey": "workflows.specs.setupLanguages.params.updateLangSwitch.label",
            "helpKey": "workflows.specs.setupLanguages.params.updateLangSwitch.help",
            "default": true
        }
    ],
    "dataRequirements": [
        {
            "id": "allLanguages",
            "command": "getLanguageList",
            "extract": "data.languages"
        },
        {
            "id": "langData",
            "command": "getLangList",
            "extract": "data"
        }
    ],
    "relatedCommands": ["addLang", "deleteLang", "setDefaultLang", "setMultilingual"],
    "steps": [
        {
            "comment": "=== MULTI-LANG 1. Enable multilingual support (only when it is off) ===",
            "condition": "param.multilingual === true && langData.multilingual_enabled !== true",
            "command": "setMultilingual",
            "params": {
                "enabled": true
            }
        },
        {
            "comment": "=== MULTI-LANG 2. Add only the languages the user picked that aren't already present ===",
            "condition": "param.multilingual === true",
            "forEach": "param.languages",
            "filter": "{{$value}} not_in {{data.langData.languages}}",
            "command": "addLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 3. Add the chosen base language (only when it is not present) ===",
            "condition": "param.multilingual !== true",
            "forEach": "param.defaultLanguage",
            "filter": "{{$value}} not_in {{data.langData.languages}}",
            "command": "addLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 4. Enable multilingual for a moment, so the default can change (only when it is off) ===",
            "condition": "param.multilingual !== true && langData.multilingual_enabled !== true && param.defaultLanguage !== {{langData.default_language}}",
            "command": "setMultilingual",
            "params": {
                "enabled": true
            }
        },
        {
            "comment": "=== SHARED 5. Set default language (only when different from current), before any language is removed: the default cannot be ===",
            "condition": "param.defaultLanguage !== {{langData.default_language}}",
            "command": "setDefaultLang",
            "params": {
                "lang": "{{param.defaultLanguage}}"
            }
        },
        {
            "comment": "=== MULTI-LANG 6. Remove only the languages currently present that the user un-picked ===",
            "condition": "param.multilingual === true",
            "forEach": "data.langData.languages",
            "filter": "{{$value}} not_in {{param.languages}}",
            "command": "deleteLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 7. Delete every existing language except the chosen default ===",
            "condition": "param.multilingual !== true",
            "forEach": "data.langData.languages",
            "filter": "{{$value}} !== {{param.defaultLanguage}}",
            "command": "deleteLang",
            "params": {
                "code": "{{$value}}"
            }
        },
        {
            "comment": "=== SINGLE-LANG 8. Disable multilingual now that only one language remains (it was on) ===",
            "condition": "param.multilingual !== true && langData.multilingual_enabled === true",
            "command": "setMultilingual",
            "params": {
                "enabled": false
            }
        },
        {
            "comment": "=== SINGLE-LANG 9. Disable multilingual again (SINGLE-LANG 4 enabled it) ===",
            "condition": "param.multilingual !== true && langData.multilingual_enabled !== true && param.defaultLanguage !== {{langData.default_language}}",
            "command": "setMultilingual",
            "params": {
                "enabled": false
            }
        }
    ],
    "postWorkflows": [
        {
            "id": "update-lang-switch",
            "condition": "param.updateLangSwitch === true"
        }
    ]
}
